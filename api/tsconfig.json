{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "types": ["node"],
    "strict": false,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["./**/*.ts", "../server/**/*.ts"]
}
