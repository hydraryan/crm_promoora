MONGODB_USERNAME=<your_db_username>
MONGODB_PASSWORD=<your_db_password>
MONGODB_URI=mongodb+srv://<your_db_username>:<your_db_password>@cluster0.w80muoq.mongodb.net/?appName=Cluster0
# Optional: standard URI fallback used when SRV DNS lookup fails in local networks.
# MONGODB_URI_FALLBACK=mongodb://<host1>:27017,<host2>:27017,<host3>:27017/?replicaSet=<replicaSetName>&ssl=true&authSource=admin

# Frontend API Configuration
VITE_API_URL=http://localhost:4000/api

# Backend JWT Secret (change in production)
JWT_SECRET=your-secret-key
