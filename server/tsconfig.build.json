{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "verbatimModuleSyntax": false,
    "allowImportingTsExtensions": false,
    "noEmit": false,
    "outDir": "../server-dist",
    "rootDir": "./",
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "./app.ts",
    "./config/**/*.ts",
    "./middleware/**/*.ts",
    "./models/**/*.ts",
    "./routes/**/*.ts"
  ],
  "exclude": [
    "../node_modules",
    "../dist",
    "../server-dist",
    "./index.ts",
    "./seed-data.ts",
    "./test-connection.ts"
  ]
}
